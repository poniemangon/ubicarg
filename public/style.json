{
  "version": 8,
  "sources": {
    "satellite": {
      "type": "raster",
      "tiles": ["https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"],
      "tileSize": 256
    },
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "satellite",
      "type": "raster",
      "source": "satellite"
    },
    {
      "id": "road",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.2, 14, 0.4, 18, 0.55],
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 15, 2.5]
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": {
        "line-color": "hsla(34, 12%, 66%, 0.5)",
        "line-width": 1
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "boundary",
      "filter": ["all", ["<=", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], true]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffe066",
        "line-opacity": 0.95,
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 1, 6, 2.5, 12, 4]
      }
    }
  ]
}
